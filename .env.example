# Copy to .env and adjust. Every value is optional; defaults suit a local install.

# Host port for the web app (always bound to 127.0.0.1).
PORT=8000

# Jobs processed at the same time. Whisper is memory hungry: keep 1 unless you
# have plenty of RAM/VRAM (ADR 0002).
WORKER_CONCURRENCY=1

# Generated on first run and stored in the data volume when empty.
DJANGO_SECRET_KEY=

# Never enable on an install other people can reach.
DJANGO_DEBUG=false

# Widening this exposes the app (and any saved AI key) to your network (ADR 0001).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
