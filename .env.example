DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=video_transcription
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/video_transcription

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Modelo do Whisper: tiny, base, small, medium, large
# 'small' roda bem em maquinas com ~3-4 GB de RAM. Use 'medium'/'large' se tiver mais memoria.
WHISPER_MODEL=small

# Idioma padrao: auto (detecta sozinho), pt, en, es, fr, de, it, ja, zh, ru
# A escolha feita na tela de upload tem prioridade sobre esta variavel.
WHISPER_LANGUAGE=auto
CELERY_WORKER_CONCURRENCY=1
